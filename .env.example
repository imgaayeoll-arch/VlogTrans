# VlogTrans environment configuration
# Copy this file to .env and fill in your values

# YouTube channel URLs (comma-separated)
YOUTUBE_CHANNEL_URL=https://youtube.com/@sydneyserena
YOUTUBE_CHANNEL_URLS=https://youtube.com/@sydneyserena

# Paths
DOWNLOAD_PATH=data/videos
SUBTITLE_PATH=data/subtitles
OUTPUT_PATH=data/output
CACHE_PATH=data/cache
VIDEO_ID_STORE_PATH=data/downloaded_video_ids.json
DB_PATH=data/storage.json

# YouTube cookies (Netscape format, exported from browser)
# Required for downloading 1080p videos
YOUTUBE_COOKIES_PATH=www.youtube.com_cookies.txt

# yt-dlp path
YT_DLP_PATH=yt-dlp

# FFmpeg path
FFMPEG_PATH=ffmpeg

# HuggingFace endpoint（国内可使用镜像加速模型下载）
HF_ENDPOINT=https://hf-mirror.com

# Whisper model (tiny.en / base.en / small.en / medium.en / large-v3)
# Uses Faster-Whisper (CTranslate2) for CPU-optimized inference
WHISPER_MODEL=medium.en

# Translation backend
TRANSLATION_BACKEND=ollama

# Ollama settings
OLLAMA_HOST=http://127.0.0.1:11434
TRANSLATION_MODEL=qwen2.5
OLLAMA_DISABLE_PROXY=true

# DeepSeek API（可选，配置后可作为主翻译线路）
# 留空则仅使用 Ollama
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 翻译后端 fallback 链（逗号分隔，前者优先）
# 留空则使用 TRANSLATION_BACKEND 单值（向后兼容）
# 示例：deepseek,ollama 表示先试 DeepSeek，失败切 Ollama
TRANSLATION_BACKENDS_ORDER=deepseek,ollama

# Retry settings
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# Proxy (optional)
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
