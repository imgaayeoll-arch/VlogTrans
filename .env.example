# VlogTrans environment configuration
# Copy this file to .env and fill in your values

# YouTube channel URLs (comma-separated)
YOUTUBE_CHANNEL_URL=https://youtube.com/@sydneyserena
YOUTUBE_CHANNEL_URLS=https://youtube.com/@sydneyserena

# Paths
DOWNLOAD_PATH=data/videos
SUBTITLE_PATH=data/subtitles
OUTPUT_PATH=data/output
CACHE_PATH=data/cache
VIDEO_ID_STORE_PATH=data/downloaded_video_ids.json
DB_PATH=data/storage.json

# YouTube cookies (Netscape format, exported from browser)
# Required for downloading 1080p videos
YOUTUBE_COOKIES_PATH=www.youtube.com_cookies.txt

# yt-dlp path
YT_DLP_PATH=yt-dlp

# FFmpeg path
FFMPEG_PATH=ffmpeg

# Whisper model (tiny.en / base.en / small.en / medium.en / large.en)
WHISPER_MODEL=medium.en

# Translation backend
TRANSLATION_BACKEND=ollama

# Ollama settings
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=deepset/your-model
DEESEEK_MODEL=qwen2.5
OLLAMA_DISABLE_PROXY=true

# Retry settings
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# Proxy (optional)
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
